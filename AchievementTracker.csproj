<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Files the app needs next to the .exe (also copied by "dotnet publish") -->
  <ItemGroup>
    <None Update="unlock.mp3" CopyToOutputDirectory="PreserveNewest" />
    <None Update="app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="achievement_dictionary.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="achievement_icons.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="tracked_games.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>